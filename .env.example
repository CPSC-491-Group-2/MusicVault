# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real secrets. Docker Compose and the backend both read it.

# --- Flask ---
# Signs session cookies (OAuth state, logged-in user). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Where the backend sends users after login. Also the allowed CORS origin.
# Use the same host as SPOTIFY_REDIRECT_URI (127.0.0.1, not localhost) so the
# login session cookie is still there when the user lands back on the site.
FRONTEND_URL=http://127.0.0.1:3000
# Set to True when the site is served over HTTPS.
SESSION_COOKIE_SECURE=False

# --- Database ---
DATABASE_URL=postgresql+psycopg2://localhost:5432/musicvault
# Backend tests only. The database name must end in "_test": pytest creates it
# if needed and wipes and rebuilds its tables on every run. pytest does not
# read this file, so export it in your shell instead (see README).
# TEST_DATABASE_URL=postgresql+psycopg2://localhost:5432/musicvault_test

# --- Spotify OAuth ---
# From your app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match a redirect URI registered in the Spotify dashboard.
# Spotify rejects "localhost" -- use 127.0.0.1 for local development.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback
