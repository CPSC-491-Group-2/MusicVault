{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "oxc",
    "typescript",
    "unicorn",
    "react",
    "jsx-a11y",
    "nextjs",
    "import"
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": [".next/**", "node_modules/**"],
  "overrides": [
    {
      "files": ["tests/**"],
      "excludeFiles": ["tests/fixtures/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@playwright/test",
                "message": "Import test and expect from tests/fixtures instead, so specs get mockApi, a11yAllowlist and toPassAxe."
              }
            ]
          }
        ]
      }
    }
  ]
}
